    "wires": []
  },
  {
    "id": "jwt_inject_invalid",
    "type": "inject",
    "z": "jwt_tab",
    "name": "4. Send with invalid token",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 180,
    "y": 420,
    "wires": [["jwt_fn_invalid"]]
  },
  {
    "id": "jwt_fn_invalid",
    "type": "function",
    "z": "jwt_tab",
    "name": "Prepare invalid request",
    "func": "msg.headers = {\n    'Content-Type': 'application/json',\n    'Authorization': 'Bearer invalid-token-xxx'\n};\nmsg.payload = {\n    temperature: 99.9,\n    humidity: 99\n};\nreturn msg;",
    "outputs": 1,
    "x": 420,
    "y": 420,
    "wires": [["jwt_http_post"]]
  }
]
