[
  {
    "id": "jwt_tab",
    "type": "tab",
    "label": "03 – JWT Auth",
    "disabled": false,
    "info": "IoT Gateway demo: JWT authentication against Express.js backend on port 3003."
  },
  {
    "id": "jwt_inject_login",
    "type": "inject",
    "z": "jwt_tab",
    "name": "1. Login",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 130,
    "y": 80,
    "wires": [["jwt_fn_login"]]
  },
  {
    "id": "jwt_fn_login",
    "type": "function",
    "z": "jwt_tab",
    "name": "Prepare login request",
    "func": "msg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { deviceId: 'gateway-01', secret: 's3cret-gw01' };\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 80,
    "wires": [["jwt_http_login"]]
  },
  {
    "id": "jwt_http_login",
    "type": "http request",
    "z": "jwt_tab",
    "name": "POST /api/auth/login",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:3003/api/auth/login",
    "x": 570,
    "y": 80,
    "wires": [["jwt_fn_store_token"]]
  },
  {
    "id": "jwt_fn_store_token",
    "type": "function",
    "z": "jwt_tab",
    "name": "Store token",
    "func": "flow.set('jwt_token', msg.payload.token);\nreturn msg;",
    "outputs": 1,
    "x": 770,
    "y": 80,
    "wires": [["jwt_debug_login"]]
  },
  {
    "id": "jwt_debug_login",
    "type": "debug",
    "z": "jwt_tab",
    "name": "Login response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "statusType": "auto",
    "x": 950,
    "y": 80,
    "wires": []
  },
  {
    "id": "jwt_inject_valid",
    "type": "inject",
    "z": "jwt_tab",
    "name": "2. Send valid telemetry",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 170,
    "y": 180,
    "wires": [["jwt_fn_valid"]]
  },
  {
    "id": "jwt_fn_valid",
    "type": "function",
    "z": "jwt_tab",
    "name": "Prepare valid request",
    "func": "var token = flow.get('jwt_token');\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Authorization': 'Bearer ' + token\n};\nmsg.payload = {\n    temperature: +(20 + Math.random() * 10).toFixed(1),\n    humidity: +(40 + Math.random() * 40).toFixed(0)\n};\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 180,
    "wires": [["jwt_http_post"]]
  },
  {
    "id": "jwt_http_post",
    "type": "http request",
    "z": "jwt_tab",
    "name": "POST /api/telemetry",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:3003/api/telemetry",
    "x": 630,
    "y": 220,
    "wires": [["jwt_debug_post"]]
  },
  {
    "id": "jwt_debug_post",
    "type": "debug",
    "z": "jwt_tab",
    "name": "POST response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "statusType": "auto",
    "x": 850,
    "y": 220,
    "wires": []
  },
  {
    "id": "jwt_inject_list",
    "type": "inject",
    "z": "jwt_tab",
    "name": "3. List telemetry",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 150,
    "y": 320,
    "wires": [["jwt_http_get"]]
  },
  {
    "id": "jwt_http_get",
    "type": "http request",
    "z": "jwt_tab",
    "name": "GET /api/telemetry",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:3003/api/telemetry",
    "x": 400,
    "y": 320,
    "wires": [["jwt_debug_get"]]
  },
  {
    "id": "jwt_debug_get",
    "type": "debug",
    "z": "jwt_tab",
