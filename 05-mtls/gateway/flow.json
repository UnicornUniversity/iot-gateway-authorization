[
  {
    "id": "mtls_tab",
    "type": "tab",
    "label": "05 – mTLS",
    "disabled": false,
    "info": "IoT Gateway demo: Mutual TLS (mTLS) authentication against Express.js HTTPS backend on port 3005.\n\nThe flow includes a TLS config node with certificate paths.\nAdjust the paths in the 'mTLS Certificates' config node if needed."
  },
  {
    "id": "mtls_tls_config",
    "type": "tls-config",
    "name": "mTLS Certificates",
    "cert": "05-mtls/certs/client-cert.pem",
    "key": "05-mtls/certs/client-key.pem",
    "ca": "05-mtls/certs/ca-cert.pem",
    "certname": "",
    "keyname": "",
    "caname": "",
    "servername": "",
    "verifyservercert": false
  },
  {
    "id": "mtls_tls_config_noauth",
    "type": "tls-config",
    "name": "CA only (no client cert)",
    "cert": "",
    "key": "",
    "ca": "05-mtls/certs/ca-cert.pem",
    "certname": "",
    "keyname": "",
    "caname": "",
    "servername": "",
    "verifyservercert": false
  },
  {
    "id": "mtls_comment_tls",
    "type": "comment",
    "z": "mtls_tab",
    "name": "⚠ Adjust cert paths in TLS config nodes if Node-RED runs from a different directory",
    "info": "The TLS config nodes use relative paths (05-mtls/certs/...).\nThese are relative to the Node-RED working directory.\n\nIf Node-RED runs from a different directory, update the paths\nin the two TLS config nodes ('mTLS Certificates' and 'CA only').\n\nFirst run: bash 05-mtls/generate-certs.sh",
    "x": 330,
    "y": 40,
    "wires": []
  },
  {
    "id": "mtls_inject_valid",
    "type": "inject",
    "z": "mtls_tab",
    "name": "Send VALID telemetry (with client cert)",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 220,
    "y": 120,
    "wires": [["mtls_fn_valid"]]
  },
  {
    "id": "mtls_fn_valid",
    "type": "function",
    "z": "mtls_tab",
    "name": "Prepare request",
    "func": "msg.headers = {\n    'Content-Type': 'application/json'\n};\nmsg.payload = {\n    temperature: +(20 + Math.random() * 10).toFixed(1),\n    humidity: +(40 + Math.random() * 40).toFixed(0)\n};\nreturn msg;",
    "outputs": 1,
    "x": 470,
    "y": 120,
    "wires": [["mtls_http_post"]]
  },
  {
    "id": "mtls_http_post",
    "type": "http request",
    "z": "mtls_tab",
    "name": "POST /api/telemetry (mTLS)",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://localhost:3005/api/telemetry",
    "tls": "mtls_tls_config",
    "x": 690,
    "y": 120,
    "wires": [["mtls_debug_post"]]
  },
  {
    "id": "mtls_debug_post",
    "type": "debug",
    "z": "mtls_tab",
    "name": "POST response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "statusType": "auto",
    "x": 910,
    "y": 120,
    "wires": []
  },
  {
    "id": "mtls_inject_invalid",
    "type": "inject",
    "z": "mtls_tab",
    "name": "Send WITHOUT client cert (should fail)",
    "props": [],
    "repeat": "",
    "once": false,
    "x": 220,
    "y": 220,
    "wires": [["mtls_fn_invalid"]]
  },
  {
    "id": "mtls_fn_invalid",
    "type": "function",
    "z": "mtls_tab",
    "name": "Prepare request (no cert)",
    "func": "msg.headers = {\n    'Content-Type': 'application/json'\n};\nmsg.payload = {\n    temperature: 99.9,\n    humidity: 99\n};\nreturn msg;",
    "outputs": 1,
    "x": 480,
    "y": 220,
    "wires": [["mtls_http_post_nocert"]]
  },
  {
    "id": "mtls_http_post_nocert",
    "type": "http request",
    "z": "mtls_tab",
    "name": "POST /api/telemetry (no client cert)",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://localhost:3005/api/telemetry",
    "tls": "mtls_tls_config_noauth",
    "x": 720,
    "y": 220,
    "wires": [["mtls_debug_post_nocert"]]
  },
  {
    "id": "mtls_debug_post_nocert",
    "type": "debug",
    "z": "mtls_tab",
    "name": "POST response (should be 401)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "statusType": "auto",
    "x": 960,
    "y": 220,
    "wires": []
  },
